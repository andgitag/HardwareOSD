<Window x:Class="HardwareOSD.App.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HardwareOSD.App.Overlay"
        Title="HardwareOSD Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        ShowActivated="False"
        Focusable="False"
        IsTabStop="False"
        UseLayoutRounding="True">
    <local:OverlaySurface x:Name="Surface" />
</Window>
