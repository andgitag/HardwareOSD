<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>HardwareOSD.App</RootNamespace>
    <AssemblyName>HardwareOSD</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <PublishTrimmed>false</PublishTrimmed>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HardwareOSD.Core\HardwareOSD.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Assets\app.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localization\strings-en.json" LogicalName="HardwareOSD.App.Localization.strings-en.json" />
    <EmbeddedResource Include="Localization\strings-uk.json" LogicalName="HardwareOSD.App.Localization.strings-uk.json" />
  </ItemGroup>

</Project>
