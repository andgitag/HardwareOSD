<Window x:Class="HardwareOSD.App.Views.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:HardwareOSD.App.Localization"
        Title="{l:LocText color_title}"
        AutomationProperties.AutomationId="ColorPickerWindow"
        Width="380"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource UiFont}">
    <StackPanel Margin="16">
        <Border Height="64" CornerRadius="3" BorderBrush="{DynamicResource BorderStrongBrush}"
                BorderThickness="1">
            <Border x:Name="Preview" CornerRadius="2" />
        </Border>
        <TextBlock Text="{l:LocText color_hint}" Style="{StaticResource Muted}"
                   Margin="0,7,0,0" />

        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="22" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="42" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{l:LocText color_red}" VerticalAlignment="Center" Foreground="#FF8080" />
            <Slider Grid.Column="1" x:Name="RedSlider" Minimum="0" Maximum="255" TickFrequency="1"
                    IsSnapToTickEnabled="True" />
            <TextBlock Grid.Column="2" x:Name="RedValue" Style="{StaticResource ValueText}"
                       HorizontalAlignment="Right" />
        </Grid>
        <Grid Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="22" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="42" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{l:LocText color_green}" VerticalAlignment="Center" Foreground="#80E080" />
            <Slider Grid.Column="1" x:Name="GreenSlider" Minimum="0" Maximum="255" TickFrequency="1"
                    IsSnapToTickEnabled="True" />
            <TextBlock Grid.Column="2" x:Name="GreenValue" Style="{StaticResource ValueText}"
                       HorizontalAlignment="Right" />
        </Grid>
        <Grid Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="22" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="42" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{l:LocText color_blue}" VerticalAlignment="Center" Foreground="#90B0FF" />
            <Slider Grid.Column="1" x:Name="BlueSlider" Minimum="0" Maximum="255" TickFrequency="1"
                    IsSnapToTickEnabled="True" />
            <TextBlock Grid.Column="2" x:Name="BlueValue" Style="{StaticResource ValueText}"
                       HorizontalAlignment="Right" />
        </Grid>

        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="52" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{l:LocText color_hex}" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" x:Name="HexBox" FontSize="13"
                     AutomationProperties.AutomationId="ColorHexBox" />
        </Grid>

        <WrapPanel x:Name="Palette" Margin="0,12,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{l:LocText color_cancel}" IsCancel="True"
                    AutomationProperties.AutomationId="ColorCancelButton"
                    Style="{StaticResource FlatButton}" Margin="0,0,8,0" />
            <Button Content="{l:LocText color_use}" IsDefault="True" Style="{StaticResource PrimaryButton}"
                    AutomationProperties.AutomationId="ColorUseButton"
                    Click="Ok_Click" />
        </StackPanel>
    </StackPanel>
</Window>
