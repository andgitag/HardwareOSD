<UserControl x:Class="HardwareOSD.App.Views.SystemPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:HardwareOSD.App.Localization"
             Background="{DynamicResource SystemPageBrush}"
             TextOptions.TextFormattingMode="Ideal"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <StackPanel Margin="17,17,19,22">
        <!-- ===================================================== -->
        <!-- Operating system                                       -->
        <!-- ===================================================== -->
        <Border Style="{StaticResource SystemCard}" Height="56" Padding="24,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Viewbox Width="21" Height="23" VerticalAlignment="Center">
                    <Canvas Width="21" Height="23">
                        <Path Fill="{DynamicResource SystemDimBrush}" Data="M0,4.6 L9.2,2.8 L9.2,10.4 L0,10.4 Z" />
                        <Path Fill="{DynamicResource SystemDimBrush}" Data="M10.4,2.6 L21,0.6 L21,10.4 L10.4,10.4 Z" />
                        <Path Fill="{DynamicResource SystemDimBrush}" Data="M0,11.8 L9.2,11.8 L9.2,19.4 L0,17.6 Z" />
                        <Path Fill="{DynamicResource SystemDimBrush}" Data="M10.4,11.8 L21,11.8 L21,21.4 L10.4,19.4 Z" />
                    </Canvas>
                </Viewbox>

                <StackPanel Grid.Column="1" Margin="20,0,12,0" VerticalAlignment="Center">
                    <TextBlock x:Name="OsEyebrow" Style="{StaticResource SystemEyebrow}" />
                    <TextBlock x:Name="OsTitle" Style="{StaticResource SystemCardTitle}" Margin="0,2,0,0" />
                </StackPanel>

                <Button x:Name="CopyInfoButton" Grid.Column="2" Style="{StaticResource SystemCopyButton}"
                        AutomationProperties.AutomationId="SystemCopyInfo"
                        Click="CopyInfo_Click" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <ContentControl x:Name="CopyIconHost" VerticalAlignment="Center" />
                        <TextBlock x:Name="CopyInfoLabel" Margin="8,0,0,0" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource SystemAccentBrush}" VerticalAlignment="Center"
                                   TextOptions.TextFormattingMode="Ideal" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <TextBlock x:Name="SystemErrorText" Margin="4,8,4,0" FontFamily="{DynamicResource MonoFont}"
                   FontSize="11" Foreground="{DynamicResource SystemWarnBrush}" TextWrapping="Wrap"
                   Visibility="Collapsed" />

        <!-- ===================================================== -->
        <!-- Processor | Graphics card                              -->
        <!-- ===================================================== -->
        <Grid Margin="0,11,0,0" Height="211">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="11" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource SystemCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ContentControl x:Name="CpuBrandHost" />
                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <TextBlock Style="{StaticResource SystemEyebrow}" Text="{l:LocText system_eyebrow_cpu}" />
                            <TextBlock x:Name="CpuTitle" Style="{StaticResource SystemCardTitle}" Margin="0,2,0,0" />
                            <TextBlock x:Name="CpuSubtitle" Style="{StaticResource SystemCardSubtitle}" Margin="0,3,0,0" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="2">
                        <Grid>
                            <TextBlock Style="{StaticResource SystemMetricLabel}" VerticalAlignment="Bottom"
                                       Text="{l:LocText system_load}" />
                            <TextBlock x:Name="CpuLoadPercent" Style="{StaticResource SystemMetricValue}"
                                       HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                        </Grid>
                        <Grid x:Name="CpuBar" Height="6" Margin="0,6,0,0">
                            <Border Background="{DynamicResource SystemTileBrush}" CornerRadius="3" />
                            <Border x:Name="CpuBarFill" Background="{DynamicResource SystemAccentBrush}"
                                    CornerRadius="3" HorizontalAlignment="Left" Width="0" />
                        </Grid>
                        <Grid x:Name="CpuTiles" Height="52" Margin="0,10,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource SystemCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ContentControl x:Name="GpuBrandHost" />
                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <TextBlock Style="{StaticResource SystemEyebrow}" Text="{l:LocText system_eyebrow_gpu}" />
                            <TextBlock x:Name="GpuTitle" Style="{StaticResource SystemCardTitle}" Margin="0,2,0,0" />
                            <TextBlock x:Name="GpuSubtitle" Style="{StaticResource SystemCardSubtitle}" Margin="0,3,0,0" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="2">
                        <Grid>
                            <TextBlock Style="{StaticResource SystemMetricLabel}" VerticalAlignment="Bottom"
                                       Text="{l:LocText system_load}" />
                            <TextBlock x:Name="GpuLoadPercent" Style="{StaticResource SystemMetricValue}"
                                       HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                        </Grid>
                        <Grid x:Name="GpuBar" Height="6" Margin="0,6,0,0">
                            <Border Background="{DynamicResource SystemTileBrush}" CornerRadius="3" />
                            <Border x:Name="GpuBarFill" Background="{DynamicResource SystemAccentBrush}"
                                    CornerRadius="3" HorizontalAlignment="Left" Width="0" />
                        </Grid>
                        <Grid x:Name="GpuTiles" Height="52" Margin="0,10,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ===================================================== -->
        <!-- Mainboard | Memory                                     -->
        <!-- ===================================================== -->
        <Grid Margin="0,11,0,0" Height="211">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="11" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource SystemCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ContentControl x:Name="BoardBrandHost" />
                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <TextBlock Style="{StaticResource SystemEyebrow}" Text="{l:LocText system_eyebrow_board}" />
                            <TextBlock x:Name="BoardTitle" Style="{StaticResource SystemCardTitle}" Margin="0,2,0,0" />
                            <TextBlock x:Name="BoardSubtitle" Style="{StaticResource SystemCardSubtitle}" Margin="0,3,0,0" />
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="BoardRows" Grid.Row="2" />
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource SystemCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ContentControl x:Name="MemoryBrandHost" />
                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <TextBlock Style="{StaticResource SystemEyebrow}" Text="{l:LocText system_eyebrow_memory}" />
                            <TextBlock x:Name="MemoryTitle" Style="{StaticResource SystemCardTitle}" Margin="0,2,0,0" />
                            <TextBlock x:Name="MemorySubtitle" Style="{StaticResource SystemCardSubtitle}" Margin="0,3,0,0" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="2">
                        <Grid>
                            <TextBlock Style="{StaticResource SystemMetricLabel}" VerticalAlignment="Bottom"
                                       Text="{l:LocText system_usage}" />
                            <TextBlock x:Name="MemoryUsagePercent" Style="{StaticResource SystemMetricValue}"
                                       HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                        </Grid>
                        <Grid x:Name="MemoryBar" Height="6" Margin="0,6,0,0">
                            <Border Background="{DynamicResource SystemTileBrush}" CornerRadius="3" />
                            <Border x:Name="MemoryBarFill" Background="{DynamicResource SystemAccentBrush}"
                                    CornerRadius="3" HorizontalAlignment="Left" Width="0" />
                        </Grid>
                        <Grid x:Name="MemoryTiles" Height="52" Margin="0,10,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ===================================================== -->
        <!-- Storage                                                -->
        <!-- ===================================================== -->
        <Border Style="{StaticResource SystemSectionCard}" Margin="0,11,0,0">
            <StackPanel>
                <Grid>
                    <TextBlock Style="{StaticResource SystemSectionHeader}" VerticalAlignment="Center"
                               Text="{l:LocText system_section_storage}" />
                    <TextBlock x:Name="StorageSummary" Style="{StaticResource SystemCardSubtitle}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
                <Grid x:Name="StorageList" Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <!-- ===================================================== -->
        <!-- Software components                                    -->
        <!-- ===================================================== -->
        <Border Style="{StaticResource SystemSectionCard}" Margin="0,11,0,0">
            <StackPanel>
                <TextBlock Style="{StaticResource SystemSectionHeader}"
                           Text="{l:LocText system_section_software}" />
                <Grid x:Name="SoftwareGrid" Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <!-- ===================================================== -->
        <!-- Platform security                                      -->
        <!-- ===================================================== -->
        <Border Style="{StaticResource SystemSectionCard}" Margin="0,11,0,0">
            <StackPanel>
                <TextBlock Style="{StaticResource SystemSectionHeader}"
                           Text="{l:LocText system_section_security}" />
                <Grid x:Name="SecurityGrid" Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <!-- ===================================================== -->
        <!-- Diagnostics                                            -->
        <!-- ===================================================== -->
        <Border Style="{StaticResource SystemSectionCard}" Margin="0,11,0,0">
            <StackPanel>
                <TextBlock Style="{StaticResource SystemSectionHeader}"
                           Text="{l:LocText system_section_diagnostics}" />
                <Grid x:Name="DiagnosticsGrid" Margin="0,8,0,0" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
