<Window x:Class="HardwareOSD.App.Views.OverlayBuilderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:HardwareOSD.App.Localization"
        xmlns:ov="clr-namespace:HardwareOSD.App.Overlay"
        Title="{l:LocText osd_builder_title}"
        Width="1360" Height="860" MinWidth="1120" MinHeight="760"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource UiFont}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Profile toolbar -->
        <Border Grid.Row="0" Background="{DynamicResource ChromeBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="12,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="SaveButton" Content="{l:LocText osd_ed_save}"
                            Style="{StaticResource PrimaryButton}" Click="Save_Click"
                            AutomationProperties.AutomationId="OsdSaveButton" />
                    <Button x:Name="ImportButton" Content="{l:LocText osd_import}"
                            Style="{StaticResource FlatButton}" Margin="6,0,0,0" Click="Import_Click" />
                    <Button x:Name="ExportButton" Content="{l:LocText osd_export}"
                            Style="{StaticResource FlatButton}" Margin="6,0,0,0" Click="Export_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{l:LocText osd_profile}" Style="{StaticResource FieldLabel}"
                               Margin="0,0,7,0" />
                    <ComboBox x:Name="ProfileCombo" Width="230"
                              AutomationProperties.AutomationId="OsdProfileCombo"
                              SelectionChanged="ProfileCombo_SelectionChanged" />
                    <TextBox x:Name="ProfileNameBox" Width="190" Margin="7,0,0,0"
                             AutomationProperties.AutomationId="OsdProfileNameBox" />
                    <Button x:Name="NewProfileButton" Content="{l:LocText osd_new_profile}"
                            Style="{StaticResource FlatButton}" Margin="6,0,0,0" Click="NewProfile_Click" />
                    <Button x:Name="DuplicateProfileButton" Content="{l:LocText osd_duplicate}"
                            Style="{StaticResource FlatButton}" Margin="6,0,0,0" Click="DuplicateProfile_Click" />
                    <Button x:Name="RenameProfileButton" Content="{l:LocText osd_rename}"
                            Style="{StaticResource FlatButton}" Margin="6,0,0,0" Click="RenameProfile_Click" />
                    <Button x:Name="DeleteProfileButton" Content="{l:LocText osd_delete}"
                            Style="{StaticResource FlatButton}" Margin="6,0,0,0" Click="DeleteProfile_Click" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Editor header -->
        <Border Grid.Row="1" Padding="14,8" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="CopyButton" Content="{l:LocText osd_copy}"
                            Style="{StaticResource FlatButton}" Click="Copy_Click" Margin="0,0,5,0"
                            AutomationProperties.AutomationId="OsdCopyButton" />
                    <Button x:Name="PasteButton" Content="{l:LocText osd_paste}"
                            Style="{StaticResource FlatButton}" Click="Paste_Click" Margin="0,0,10,0"
                            AutomationProperties.AutomationId="OsdPasteButton" />
                    <Button x:Name="UndoButton" Content="{l:LocText osd_undo}"
                            Style="{StaticResource FlatButton}" Click="Undo_Click" Margin="0,0,5,0"
                            AutomationProperties.AutomationId="OsdUndoButton" />
                    <Button x:Name="RedoButton" Content="{l:LocText osd_redo}"
                            Style="{StaticResource FlatButton}" Click="Redo_Click"
                            AutomationProperties.AutomationId="OsdRedoButton" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{l:LocText osd_ed_title}" FontSize="19" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"
                               Margin="0,0,16,0" />
                    <Button x:Name="TemplatesButton" Content="{l:LocText osd_ed_templates}"
                            Style="{StaticResource FlatButton}" HorizontalAlignment="Left"
                            Click="Templates_Click"
                            AutomationProperties.AutomationId="OsdTemplatesButton" />
                    <Button x:Name="StartButton" Content="{l:LocText osd_ed_start}"
                            Style="{StaticResource FlatButton}" HorizontalAlignment="Left"
                            Margin="8,0,0,0" Click="Start_Click"
                            AutomationProperties.AutomationId="OsdStartButton" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Working area -->
        <Grid Grid.Row="2" x:Name="BodyGrid" Margin="12,10,12,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="230" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" MinWidth="320" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="360" MinWidth="280" />
            </Grid.ColumnDefinitions>

            <!-- Left palette -->
            <Border x:Name="LeftPanel" Grid.Column="0" Style="{StaticResource Surface}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                            Padding="8,6">
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton x:Name="AddTab" Content="{l:LocText osd_ed_add}"
                                          Style="{StaticResource TabButton}"
                                          Checked="AddTab_Checked" AutomationProperties.AutomationId="OsdAddTab" />
                            <ToggleButton x:Name="TilesTab" Content="{l:LocText osd_ed_tiles}"
                                          Style="{StaticResource TabButton}" Checked="TilesTab_Checked"
                                          AutomationProperties.AutomationId="OsdTilesTab" />
                            <ToggleButton x:Name="SourcesTab" Content="{l:LocText osd_ed_sources}"
                                          Style="{StaticResource TabButton}" Checked="SourcesTab_Checked"
                                          AutomationProperties.AutomationId="OsdSourcesTab" />
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="1">
                        <!-- Add -->
                        <ScrollViewer x:Name="AddPanel" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" Padding="10,9">
                            <StackPanel>
                                <TextBlock Text="{l:LocText osd_ed_add_hint}" Style="{StaticResource Muted}" />
                                <StackPanel x:Name="WidgetPalette" Margin="0,8,0,0" />
                                <TextBlock Text="{l:LocText osd_ed_add_footer}" Style="{StaticResource Caption}"
                                           TextWrapping="Wrap" Margin="0,10,0,0" />
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Tiles / layers -->
                        <Grid x:Name="TilesPanel" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Margin="10,9,10,4">
                                <TextBlock x:Name="LayerCaption" Text="{l:LocText osd_ed_layers}"
                                           Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="{l:LocText osd_ed_layers_hint}" Style="{StaticResource Muted}"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                            <ListBox Grid.Row="1" x:Name="TileList" Margin="6,4"
                                     AutomationProperties.AutomationId="OsdTileList"
                                     BorderThickness="0" Background="Transparent"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     SelectionChanged="TileList_SelectionChanged"
                                     MouseDoubleClick="TileList_MouseDoubleClick"
                                     PreviewMouseLeftButtonDown="TileList_PreviewMouseLeftButtonDown"
                                     PreviewMouseMove="TileList_PreviewMouseMove"
                                     AllowDrop="True" Drop="TileList_Drop" DragOver="TileList_DragOver" />
                            <Grid Grid.Row="2" Margin="10,4,10,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Button x:Name="SendBackwardButton" Content="{l:LocText osd_ed_backward}"
                                        Style="{StaticResource FlatButton}" Margin="0,0,3,4"
                                        Click="SendBackward_Click" />
                                <Button x:Name="BringForwardButton" Content="{l:LocText osd_ed_forward}"
                                        Style="{StaticResource FlatButton}" Grid.Column="1"
                                        Margin="3,0,0,4" Click="BringForward_Click" />
                                <Button x:Name="DuplicateElementButton" Content="{l:LocText osd_duplicate_item}"
                                        Style="{StaticResource FlatButton}" Grid.Row="1"
                                        Margin="0,0,3,0" Click="DuplicateElement_Click" />
                                <Button x:Name="DeleteElementButton" Content="{l:LocText osd_delete_item}"
                                        Style="{StaticResource DangerButton}" Grid.Row="1" Grid.Column="1"
                                        Margin="3,0,0,0" Click="DeleteElement_Click" />
                            </Grid>
                        </Grid>

                        <!-- Sources -->
                        <Grid x:Name="SourcesPanel" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Margin="10,9,10,4">
                                <TextBlock Text="{l:LocText osd_ed_sources_hint}" Style="{StaticResource Muted}" />
                                <TextBox x:Name="SourceSearch" Margin="0,6,0,0"
                                         ToolTip="{l:LocText osd_ed_source_search_tip}"
                                         TextChanged="SourceSearch_TextChanged"
                                         AutomationProperties.AutomationId="OsdSourceSearch" />
                                <TextBlock Text="{l:LocText osd_ed_search_sources}" IsHitTestVisible="False"
                                           Margin="9,6,0,0" VerticalAlignment="Top"
                                           Foreground="{DynamicResource DimBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=SourceSearch}"
                                                             Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ComboBox x:Name="SourceCategoryCombo" Margin="0,6,0,0"
                                          SelectionChanged="SourceFilter_Changed" />
                                <TextBlock x:Name="SourceSummary" Style="{StaticResource Caption}"
                                           Margin="0,5,0,0" />
                            </StackPanel>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled" Padding="6,0,6,8">
                                <StackPanel x:Name="SourceList" />
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch"
                          Background="Transparent" ResizeBehavior="PreviousAndNext" />

            <!-- Centre: preview -->
            <Border Grid.Column="2" Style="{StaticResource Surface}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                            Padding="10,7">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BackButton" Content="{l:LocText osd_ed_back}"
                                        Style="{StaticResource FlatButton}" Margin="0,0,8,0"
                                        Visibility="Collapsed" Click="Back_Click"
                                        AutomationProperties.AutomationId="OsdBackButton" />
                                <TextBlock x:Name="ScopeCaption" Style="{StaticResource Caption}"
                                           FontSize="11" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="ProfileHeaderHint" Style="{StaticResource Caption}"
                                           Margin="8,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="PreviewInfoText" Margin="12,0,0,0"
                                           Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                <TextBlock x:Name="PreviewModeBadge" Visibility="Collapsed"
                                           Margin="10,0,0,0" VerticalAlignment="Center"
                                           FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource WarningBrush}"
                                           AutomationProperties.AutomationId="OsdPreviewModeBadge" />
                                <CheckBox x:Name="LiveCheck" Content="{l:LocText osd_ed_live}"
                                          Foreground="{DynamicResource TextBrush}"
                                          VerticalAlignment="Center" Margin="12,0,0,0"
                                          IsChecked="True" Checked="LiveCheck_Changed" Unchecked="LiveCheck_Changed"
                                          AutomationProperties.AutomationId="OsdLiveCheck" />
                                <CheckBox x:Name="DemoCheck" Content="{l:LocText osd_ed_demo}"
                                          Foreground="{DynamicResource TextBrush}"
                                          VerticalAlignment="Center" Margin="10,0,0,0"
                                          Checked="DemoCheck_Changed" Unchecked="DemoCheck_Changed"
                                          AutomationProperties.AutomationId="OsdDemoCheck" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ScrollViewer x:Name="CanvasScroller" Grid.Row="1" Margin="8"
                                  Background="{DynamicResource PreviewBackgroundBrush}"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalContentAlignment="Center"
                                  VerticalContentAlignment="Center"
                                  AutomationProperties.AutomationId="OsdCanvasScroller">
                        <ov:TileEditorCanvas x:Name="EditorCanvas"
                                             AllowDrop="True" DragOver="EditorCanvas_DragOver"
                                             DragLeave="EditorCanvas_DragLeave"
                                             Drop="EditorCanvas_Drop" />
                    </ScrollViewer>

                    <Border x:Name="RowProfilePanel" Grid.Row="1" Margin="8" Visibility="Collapsed"
                            Background="{DynamicResource PanelBrush}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    MaxWidth="380">
                            <TextBlock Text="{l:LocText osd_ed_row_profile}" FontSize="15"
                                       FontWeight="SemiBold" TextWrapping="Wrap"
                                       TextAlignment="Center" />
                            <TextBlock Text="{l:LocText osd_ed_row_profile_hint}"
                                       Style="{StaticResource Muted}" TextAlignment="Center"
                                       Margin="0,8,0,12" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" x:Name="DeleteZone" Height="34" Margin="8,0,8,8"
                            BorderThickness="1" CornerRadius="2" AllowDrop="True"
                            Background="{DynamicResource FieldBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            Drop="DeleteZone_Drop" DragOver="DeleteZone_DragOver"
                            DragLeave="DeleteZone_DragLeave">
                        <TextBlock Text="{l:LocText osd_ed_delete_zone}" Style="{StaticResource Caption}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="3" Width="8" HorizontalAlignment="Stretch"
                          Background="Transparent" ResizeBehavior="PreviousAndNext" />

            <!-- Right inspector -->
            <Border Grid.Column="4" Style="{StaticResource Surface}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                            Padding="8,6">
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton x:Name="TileTab" Content="{l:LocText osd_ed_tile}"
                                          Style="{StaticResource TabButton}"
                                          Checked="TileTab_Click" AutomationProperties.AutomationId="OsdTileTab" />
                            <ToggleButton x:Name="LayoutTab" Content="{l:LocText osd_ed_layout}"
                                          Style="{StaticResource TabButton}" Checked="LayoutTab_Click"
                                          AutomationProperties.AutomationId="OsdLayoutTab" />
                            <ToggleButton x:Name="StyleTab" Content="{l:LocText osd_ed_style}"
                                          Style="{StaticResource TabButton}" Checked="StyleTab_Click"
                                          AutomationProperties.AutomationId="OsdStyleTab" />
                        </StackPanel>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Padding="12,8,12,12">
                        <StackPanel x:Name="InspectorPanel" />
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Template gallery overlay -->
            <Border x:Name="TemplateGallery" Grid.ColumnSpan="5" Visibility="Collapsed"
                    Background="{DynamicResource AppBackgroundBrush}"
                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                    CornerRadius="4" Padding="18" Panel.ZIndex="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <Button x:Name="CloseGalleryButton" Content="{l:LocText osd_ed_close}"
                                Style="{StaticResource FlatButton}" DockPanel.Dock="Right"
                                VerticalAlignment="Top" Click="CloseGallery_Click" />
                        <StackPanel>
                            <TextBlock Text="{l:LocText osd_ed_gallery}" FontSize="20" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Text="{l:LocText osd_ed_gallery_hint}" Style="{StaticResource Muted}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,10">
                        <Grid Width="260">
                            <TextBox x:Name="TemplateSearch"
                                     ToolTip="{l:LocText osd_ed_template_search_tip}"
                                     TextChanged="TemplateSearch_TextChanged" />
                            <TextBlock Text="{l:LocText osd_ed_search_templates}" IsHitTestVisible="False"
                                       Margin="9,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource DimBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=TemplateSearch}"
                                                         Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <ComboBox x:Name="TemplateCategoryCombo" Width="190" Margin="8,0,0,0"
                                  SelectionChanged="TemplateFilter_Changed" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <WrapPanel x:Name="TemplatePanel" />
                    </ScrollViewer>
                    <TextBlock Grid.Row="3" x:Name="TemplateFooter" Style="{StaticResource Caption}"
                               Margin="0,10,0,0" />
                </Grid>
            </Border>

            <!-- Start screen: open, create, template or blank -->
            <Border x:Name="StartupChooser" Grid.ColumnSpan="5" Visibility="Collapsed"
                    Background="{DynamicResource AppBackgroundBrush}"
                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                    CornerRadius="4" Padding="24" Panel.ZIndex="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="{l:LocText osd_start_title}" FontSize="24" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Text="{l:LocText osd_start_subtitle}" Style="{StaticResource Muted}"
                                   Margin="0,5,0,0" TextWrapping="Wrap" />
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Surface}" Padding="14" Margin="0,0,8,8">
                            <StackPanel>
                                <TextBlock Text="{l:LocText osd_start_continue_title}"
                                           Style="{StaticResource SectionTitle}" />
                                <TextBlock x:Name="StartupCurrentText" Style="{StaticResource Muted}"
                                           Margin="0,4,0,0" TextWrapping="Wrap" />
                                <Button x:Name="StartupContinueButton" Content="{l:LocText osd_start_continue}"
                                        Style="{StaticResource PrimaryButton}" Margin="0,10,0,0"
                                        HorizontalAlignment="Left" Click="StartupContinue_Click"
                                        AutomationProperties.AutomationId="OsdStartupContinue" />
                                <Button Content="{l:LocText osd_start_open}" Style="{StaticResource FlatButton}"
                                        Margin="0,6,0,0" HorizontalAlignment="Left"
                                        Click="StartupOpenProfile_Click"
                                        AutomationProperties.AutomationId="OsdStartupOpen" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Surface}" Padding="14" Margin="8,0,0,8">
                            <StackPanel>
                                <TextBlock Text="{l:LocText osd_start_new_title}"
                                           Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="{l:LocText osd_start_new_hint}" Style="{StaticResource Muted}"
                                           Margin="0,4,0,0" TextWrapping="Wrap" />
                                <TextBox x:Name="StartupNameBox" Margin="0,8,0,0"
                                         AutomationProperties.AutomationId="OsdStartupName" />
                                <Button Content="{l:LocText osd_start_blank}" Style="{StaticResource PrimaryButton}"
                                        Margin="0,8,0,0" HorizontalAlignment="Left"
                                        Click="StartupBlank_Click"
                                        AutomationProperties.AutomationId="OsdStartupBlank" />
                                <Button Content="{l:LocText osd_start_templates}" Style="{StaticResource FlatButton}"
                                        Margin="0,6,0,0" HorizontalAlignment="Left"
                                        Click="StartupTemplates_Click"
                                        AutomationProperties.AutomationId="OsdStartupTemplates" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Row="2" Margin="0,12,0,0">
                        <TextBlock Text="{l:LocText osd_start_templates_title}"
                                   Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{l:LocText osd_start_templates_hint}"
                                   Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                            <WrapPanel x:Name="StartupTemplatePanel" />
                        </ScrollViewer>
                    </StackPanel>

                    <Button Grid.Row="3" Content="{l:LocText osd_ed_close}" Style="{StaticResource FlatButton}"
                            HorizontalAlignment="Right" Margin="0,12,0,0"
                            Click="StartupContinue_Click"
                            AutomationProperties.AutomationId="OsdStartupClose" />
                </Grid>
            </Border>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="3" Background="{DynamicResource ChromeBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="12,7">
            <DockPanel>
                <TextBlock x:Name="TileCountText" DockPanel.Dock="Right" Style="{StaticResource Caption}"
                           Margin="12,0,0,0" AutomationProperties.AutomationId="OsdTileCount" />
                <TextBlock x:Name="SourcesText" DockPanel.Dock="Right" Style="{StaticResource Caption}"
                           Margin="12,0,0,0" AutomationProperties.AutomationId="OsdSourcesText" />
                <TextBlock x:Name="SavedStateText" DockPanel.Dock="Right" Style="{StaticResource Caption}"
                           Margin="12,0,0,0" />
                <TextBlock x:Name="StatusText" Style="{StaticResource Muted}"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
