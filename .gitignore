settings.json
settings.json.bak
*.log
*.dmp
*.tmp
*.temp
~$*

# Secrets and certificates (never commit)
.env
.env.local
.env.*.local
secrets.json
credentials.json
*.pfx
*.p12
*.key
*.pem
*.snk

# IDE noise
.idea/
